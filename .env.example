# Android release signing. Keep real values in CI/local secrets only.
OP_VERSION_CODE=1
OP_VERSION_NAME=1.0
ANDROID_KEYSTORE_PATH=upload-keystore.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=openpolitics-upload
ANDROID_KEY_PASSWORD=

# GitHub Actions expects this as a base64 encoded keystore file.
ANDROID_KEYSTORE_BASE64=

# Fastlane / Google Play upload. Store the raw service account JSON as a secret.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
PLAY_TRACK=internal
